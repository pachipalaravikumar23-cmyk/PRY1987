					"sinks": [
						{
							"dataset": {
								"referenceName": "AzureSqlTable12",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "union1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          SubTotal as decimal(19,4),",
						"          TaxAmt as decimal(19,4),",
						"          FirstName as string,",
						"          LastName as string,",
						"          CompanyName as string,",
						"          Description as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT * From CS1_Distination',",
						"     format: 'query') ~> cs1source12",
						"source(output(",
						"          SubTotal as decimal(19,4),",
						"          TaxAmt as decimal(19,4),",
						"          FirstName as string,",
						"          LastName as string,",
						"          CompanyName as string,",
						"          Description as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT * From CS2_Distination',",
						"     format: 'query') ~> cs2source2",
						"cs1source12, cs2source2 union(byName: true)~> union1",
						"union1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
